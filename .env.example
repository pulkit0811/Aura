# Application
AURA_ENV=development
AURA_LOG_LEVEL=INFO

# Local service addresses
AURA_API_HOST=127.0.0.1
AURA_API_PORT=8000
AURA_WEB_ORIGIN=http://localhost:3000

# Persistence
AURA_DATABASE_URL=sqlite:///./data/aura.db

# Chat model provider
# Keep credentials out of source control. Add real values only to a local .env file.
AURA_CHAT_PROVIDER=
AURA_CHAT_MODEL=
AURA_MODEL_API_KEY=

# Embedding provider
AURA_EMBEDDING_PROVIDER=
AURA_EMBEDDING_MODEL=
AURA_EMBEDDING_API_KEY=

